+#pragma once
+
+#include <cstdint>
+#include <deque>
+
+class RollingBitrate {
+    struct Sample {
+        uint64_t atMs;
+        uint64_t bytes;
+        uint64_t durationMs;
+    };
+    std::deque<Sample> samples_;
+    bool initialized_ = false;
+    uint64_t lastTimeMs_ = 0;
+    uint64_t lastBytes_ = 0;
+    uint64_t valueKbps_ = 0;
+    static const uint64_t sampleIntervalMs_ = 1000;
+    static const uint64_t windowMs_ = 8000;
+
+public:
+    void reset() {
+        samples_.clear();
+        initialized_ = false;
+        lastTimeMs_ = 0;
+        lastBytes_ = 0;
+        valueKbps_ = 0;
+    }
+
+    int sample(uint64_t nowMs, uint64_t receivedBytes) {
+        if (!initialized_ || receivedBytes < lastBytes_ || nowMs < lastTimeMs_) {
+            reset();
+            initialized_ = true;
+            lastTimeMs_ = nowMs;
+            lastBytes_ = receivedBytes;
+            return 0;
+        }
+        const uint64_t elapsed = nowMs - lastTimeMs_;
+        if (elapsed < sampleIntervalMs_) return static_cast<int>(valueKbps_);
+
+        samples_.push_back(Sample{ nowMs, receivedBytes - lastBytes_, elapsed });
+        lastTimeMs_ = nowMs;
+        lastBytes_ = receivedBytes;
+        while (!samples_.empty() && nowMs - samples_.front().atMs >= windowMs_) samples_.pop_front();
+
+        uint64_t bytes = 0, duration = 0;
+        for (const Sample& item : samples_) { bytes += item.bytes; duration += item.durationMs; }
+        valueKbps_ = duration ? (bytes * 8) / duration : 0;
+        return static_cast<int>(valueKbps_);
+    }
+};
