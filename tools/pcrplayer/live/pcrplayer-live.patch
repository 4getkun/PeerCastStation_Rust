+void CMainDlg::AutoResizeLiveWindow()
+{
+	if (!liveAutoResizePending_) return;
+	if (IsZoomed() || gl_.screen.full || gl_.screen.maximize)
+	{
+		liveAutoResizePending_ = false;
+		return;
+	}
+
+	SIZE native = {};
+	if (!gl_.player.getNativeVideoSize(native) || native.cx <= 0 || native.cy <= 0) return;
+	liveAutoResizePending_ = false;
+
+	CRect source(0, 0, native.cx, native.cy), video;
+	SIZE aspect = {};
+	gl_.getAspect(aspect);
+	if (!utl::getAspectRect(aspect, source, video)) video = source;
+	const int videoWidth = video.Width();
+	const int videoHeight = video.Height();
+	if (videoWidth <= 0 || videoHeight <= 0) return;
+
+	CRect outer(0, 0, videoWidth, videoHeight);
+	InflateWindowRect(outer);
+	const int chromeWidth = max(0, outer.Width() - videoWidth);
+	const int chromeHeight = max(0, outer.Height() - videoHeight);
+
+	MONITORINFO monitor = {};
+	if (!utl::getDesktopRectFromWindow(GetSafeHwnd(), monitor)) return;
+	CRect work(monitor.rcWork);
+	const int availableWidth = max(1, work.Width() - chromeWidth);
+	const int availableHeight = max(1, work.Height() - chromeHeight);
+	double scale = min(1.0, min((double)availableWidth / videoWidth, (double)availableHeight / videoHeight));
+	int targetWidth = max(1, (int)(videoWidth * scale));
+	int targetHeight = max(1, (int)(videoHeight * scale));
+	outer.SetRect(0, 0, targetWidth, targetHeight);
+	InflateWindowRect(outer);
+
+	CRect current;
+	GetWindowRect(&current);
+	int left = current.left;
+	int top = current.top;
+	if (outer.Width() <= work.Width()) left = min(max(left, work.left), work.right - outer.Width());
+	else left = work.left;
+	if (outer.Height() <= work.Height()) top = min(max(top, work.top), work.bottom - outer.Height());
+	else top = work.top;
+
+	box_.showWindow(false);
+	SetWindowPos(NULL, left, top, outer.Width(), outer.Height(), SWP_NOZORDER | SWP_NOACTIVATE);
+}
