+#pragma once
+
+#include <windows.h>
+#include <string>
+#include <vector>
+#include <algorithm>
+#include <cwctype>
+#include <boost/thread.hpp>
+#include "Network.h"
+
+namespace dsp {
+
+inline std::wstring liveLower(std::wstring value)
+{
+    std::transform(value.begin(), value.end(), value.begin(), [](wchar_t ch) { return static_cast<wchar_t>(std::towlower(ch)); });
+    return value;
+}
+
+inline bool isLiveProviderPage(const std::wstring& value)
+{
+    network::URLParser url(value);
+    if (!url || liveLower(url.scheme()) != L"https" || url.port() != 443) return false;
+    const std::wstring host = liveLower(url.host());
+    return host == L"youtube.com" || host.size() > 12 && host.substr(host.size() - 12) == L".youtube.com" ||
+        host == L"youtu.be" || host == L"twitch.tv" || host.size() > 10 && host.substr(host.size() - 10) == L".twitch.tv";
+}
+
+inline std::wstring quoteLiveArg(const std::wstring& value)
+{
+    std::wstring out = L"\"";
+    size_t slashes = 0;
+    for (wchar_t ch : value)
+    {
+        if (ch == L'\\') { ++slashes; continue; }
+        if (ch == L'\"') { out.append(slashes * 2 + 1, L'\\'); out += ch; slashes = 0; continue; }
+        out.append(slashes, L'\\'); slashes = 0; out += ch;
+    }
+    out.append(slashes * 2, L'\\');
+    out += L'\"';
+    return out;
+}
+
+class LiveBridgeSession {
+    HANDLE job_ = NULL;
+    HANDLE process_ = NULL;
+    HANDLE thread_ = NULL;
+    HANDLE pipe_ = NULL;
+    std::wstring mediaUrl_;
+    int startupBufferMs_ = 0;
+
+    void closeHandles()
+    {
+        stopRecordingBeforeClose();
+        if (pipe_) { CloseHandle(pipe_); pipe_ = NULL; }
+        if (thread_) { CloseHandle(thread_); thread_ = NULL; }
+        if (process_) { CloseHandle(process_); process_ = NULL; }
+        if (job_) { CloseHandle(job_); job_ = NULL; }
+    }
+
+    static bool resolveNode(std::wstring& node)
+    {
+        wchar_t buffer[32768] = {};
+        DWORD count = GetModuleFileNameW(NULL, buffer, ARRAYSIZE(buffer));
+        if (count && count < ARRAYSIZE(buffer))
+        {
+            std::wstring base(buffer, count);
+            size_t slash = base.find_last_of(L"\\/");
+            if (slash != std::wstring::npos)
+            {
+                node = base.substr(0, slash) + L"\\Live\\node.exe";
+                if (GetFileAttributesW(node.c_str()) != INVALID_FILE_ATTRIBUTES) return true;
+            }
+        }
+        count = GetEnvironmentVariableW(L"PCRPLAYER_LIVE_NODE", buffer, ARRAYSIZE(buffer));
+        if (count > 0 && count < ARRAYSIZE(buffer)) { node.assign(buffer, count); return true; }
+        count = SearchPathW(NULL, L"node.exe", NULL, ARRAYSIZE(buffer), buffer, NULL);
+        if (!count || count >= ARRAYSIZE(buffer)) return false;
+        node.assign(buffer, count);
+        return true;
+    }
+
+    static std::wstring helperPath(std::wstring& directory)
+    {
+        wchar_t buffer[32768] = {};
+        DWORD count = GetModuleFileNameW(NULL, buffer, ARRAYSIZE(buffer));
+        if (!count || count >= ARRAYSIZE(buffer)) return L"";
+        directory.assign(buffer, count);
+        size_t slash = directory.find_last_of(L"\\/");
+        if (slash == std::wstring::npos) return L"";
+        directory.resize(slash);
+        return directory + L"\\pcr-live-bridge.cjs";
+    }
+
+    static bool validLoopbackUrl(const std::wstring& value)
+    {
+        const std::wstring prefix = L"http://127.0.0.1:";
+        if (value.compare(0, prefix.size(), prefix) != 0) return false;
+        size_t portBegin = prefix.size(), slash = value.find(L'/', portBegin);
+        if (slash == std::wstring::npos || slash == portBegin) return false;
+        unsigned port = 0;
+        for (size_t i = portBegin; i < slash; ++i)
+        {
+            if (value[i] < L'0' || value[i] > L'9') return false;
+            port = port * 10 + (value[i] - L'0');
+            if (port > 65535) return false;
+        }
+        if (!port || value.find_first_of(L"?#", slash) != std::wstring::npos) return false;
+        const std::wstring suffix = L".flv";
+        return value.size() > slash + suffix.size() && value.compare(value.size() - suffix.size(), suffix.size(), suffix) == 0;
+    }
+
+    std::wstring readRecordingState(int timeout)
+    {
+        if (mediaUrl_.empty()) return L"error";
+        network::HttpClient client;
+        if (!client.open(mediaUrl_ + L"/record", L"PCRPlayer", network::Proxy(), timeout)) return L"error";
+        DWORD status = 0;
+        if (!client.queryStatus(status) || status != 200) return L"error";
+        std::vector<char> body;
+        if (client.get(body) != network::HttpClient::STATE_EOF || body.size() > 32) return L"error";
+        while (!body.empty() && (body.back() == '\r' || body.back() == '\n')) body.pop_back();
+        std::string value(body.begin(), body.end());
+        if (value == "idle" || value == "starting" || value == "recording" || value == "stopping" || value == "error")
+            return std::wstring(value.begin(), value.end());
+        return L"error";
+    }
+
+    bool postRecordingCommand(const std::string& body, int timeout)
+    {
+        if (mediaUrl_.empty()) return false;
+        network::HttpClient client;
+        const std::wstring header = L"Content-Type: text/plain;charset=utf-8\r\n";
+        if (!client.post(mediaUrl_ + L"/record", L"PCRPlayer", network::Proxy(), body, header, timeout)) return false;
+        DWORD status = 0;
+        return client.queryStatus(status) && status == 202;
+    }
+
+    void stopRecordingBeforeClose()
+    {
+        if (mediaUrl_.empty()) return;
+        const ULONGLONG deadline = GetTickCount64() + 8000;
+        std::wstring state = readRecordingState(200);
+        if (state == L"starting" || state == L"recording")
+            postRecordingCommand(std::string(), 200);
+        while (GetTickCount64() < deadline)
+        {
+            state = readRecordingState(200);
+            if (state == L"idle" || state == L"error") return;
+            Sleep(50);
+        }
+    }
+
+public:
+    int startupBufferMs() const { return startupBufferMs_; }
+    LiveBridgeSession() = default;
+    LiveBridgeSession(const LiveBridgeSession&) = delete;
+    LiveBridgeSession& operator=(const LiveBridgeSession&) = delete;
+    ~LiveBridgeSession() { closeHandles(); }
+
+    std::wstring recordingState() { return readRecordingState(2000); }
+
+    bool startRecording(const std::wstring& path)
+    {
+        if (path.empty()) return false;
+        const int count = WideCharToMultiByte(CP_UTF8, 0, path.c_str(), -1, NULL, 0, NULL, NULL);
+        if (count <= 1) return false;
+        std::vector<char> bytes(count);
+        if (WideCharToMultiByte(CP_UTF8, 0, path.c_str(), -1, bytes.data(), count, NULL, NULL) != count) return false;
+        return postRecordingCommand(std::string(bytes.data(), count - 1), 2000);
+    }
+
+    bool stopRecording() { return postRecordingCommand(std::string(), 2000); }
+
+    bool start(const std::wstring& pageUrl, std::wstring& mediaUrl)
+    {
+        network::URLParser provider(pageUrl);
+        const std::wstring host = liveLower(provider.host());
+        startupBufferMs_ = host == L"twitch.tv" || host == L"www.twitch.tv" ? 6000 : 0;
+        std::wstring node, directory;
+        const std::wstring helper = helperPath(directory);
+        if (helper.empty() || !resolveNode(node) || GetFileAttributesW(helper.c_str()) == INVALID_FILE_ATTRIBUTES) return false;
+
+        SECURITY_ATTRIBUTES sa = { sizeof(sa), NULL, TRUE };
+        HANDLE pipeWrite = NULL;
+        if (!CreatePipe(&pipe_, &pipeWrite, &sa, 0)) return false;
+        SetHandleInformation(pipe_, HANDLE_FLAG_INHERIT, 0);
+        HANDLE nullHandle = CreateFileW(L"NUL", GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, &sa, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+        wchar_t logName[96] = {};
+        swprintf_s(logName, L"\\pcr-live-startup-%lu.log", GetCurrentProcessId());
+        HANDLE errorLog = CreateFileW((directory + logName).c_str(), FILE_APPEND_DATA, FILE_SHARE_READ, &sa, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+        if (errorLog == INVALID_HANDLE_VALUE) errorLog = CreateFileW(L"NUL", GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, &sa, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+        if (nullHandle == INVALID_HANDLE_VALUE || errorLog == INVALID_HANDLE_VALUE) { if (nullHandle != INVALID_HANDLE_VALUE) CloseHandle(nullHandle); if (errorLog != INVALID_HANDLE_VALUE) CloseHandle(errorLog); CloseHandle(pipeWrite); closeHandles(); return false; }
+
+        JOBOBJECT_EXTENDED_LIMIT_INFORMATION limits = {};
+        job_ = CreateJobObjectW(NULL, NULL);
+        if (!job_) { CloseHandle(pipeWrite); CloseHandle(nullHandle); CloseHandle(errorLog); closeHandles(); return false; }
+        limits.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
+        if (!SetInformationJobObject(job_, JobObjectExtendedLimitInformation, &limits, sizeof(limits)))
+        { CloseHandle(pipeWrite); CloseHandle(nullHandle); CloseHandle(errorLog); closeHandles(); return false; }
+
+        SIZE_T attrSize = 0;
+        InitializeProcThreadAttributeList(NULL, 1, 0, &attrSize);
+        std::vector<unsigned char> attrBuffer(attrSize);
+        LPPROC_THREAD_ATTRIBUTE_LIST attrs = reinterpret_cast<LPPROC_THREAD_ATTRIBUTE_LIST>(attrBuffer.data());
+        if (!InitializeProcThreadAttributeList(attrs, 1, 0, &attrSize))
+        { CloseHandle(pipeWrite); CloseHandle(nullHandle); CloseHandle(errorLog); closeHandles(); return false; }
+        HANDLE inherited[] = { pipeWrite, nullHandle, errorLog };
+        bool attrOk = UpdateProcThreadAttribute(attrs, 0, PROC_THREAD_ATTRIBUTE_HANDLE_LIST, inherited, sizeof(inherited), NULL, NULL) != FALSE;
+
+        STARTUPINFOEXW si = {};
+        si.StartupInfo.cb = sizeof(si);
+        si.StartupInfo.dwFlags = STARTF_USESTDHANDLES;
+        si.StartupInfo.hStdInput = nullHandle;
+        si.StartupInfo.hStdOutput = pipeWrite;
+        si.StartupInfo.hStdError = errorLog;
+        si.lpAttributeList = attrs;
+        std::wstring command = quoteLiveArg(node) + L" " + quoteLiveArg(helper) + L" " + quoteLiveArg(pageUrl) + L" --stdout";
+        std::vector<wchar_t> mutableCommand(command.begin(), command.end());
+        mutableCommand.push_back(L'\0');
+        PROCESS_INFORMATION pi = {};
+        BOOL created = attrOk && CreateProcessW(node.c_str(), mutableCommand.data(), NULL, NULL, TRUE,
+            EXTENDED_STARTUPINFO_PRESENT | CREATE_SUSPENDED | CREATE_NO_WINDOW, NULL, directory.c_str(), &si.StartupInfo, &pi);
+        DeleteProcThreadAttributeList(attrs);
+        CloseHandle(pipeWrite); CloseHandle(nullHandle); CloseHandle(errorLog);
+        if (!created) { closeHandles(); return false; }
+        process_ = pi.hProcess; thread_ = pi.hThread;
+        if (!AssignProcessToJobObject(job_, process_) || ResumeThread(thread_) == (DWORD)-1)
+        { TerminateProcess(process_, 1); closeHandles(); return false; }
+
+        const ULONGLONG deadline = GetTickCount64() + 90000;
+        std::string line;
+        while (GetTickCount64() < deadline)
+        {
+            boost::this_thread::interruption_point();
+            DWORD available = 0;
+            if (!PeekNamedPipe(pipe_, NULL, 0, NULL, &available, NULL)) { closeHandles(); return false; }
+            if (available)
+            {
+                char chunk[512]; DWORD read = 0;
+                if (!ReadFile(pipe_, chunk, (std::min<DWORD>)(available, sizeof(chunk)), &read, NULL) || !read) { closeHandles(); return false; }
+                for (DWORD i = 0; i < read; ++i)
+                {
+                    if (chunk[i] == '\n')
+                    {
+                        while (!line.empty() && line.back() == '\r') line.pop_back();
+                        std::wstring candidate(line.begin(), line.end());
+                        if (!validLoopbackUrl(candidate)) { closeHandles(); return false; }
+                        mediaUrl.swap(candidate);
+                        mediaUrl_ = mediaUrl;
+                        return true;
+                    }
+                    if (line.size() >= 4096) { closeHandles(); return false; }
+                    line.push_back(chunk[i]);
+                }
+            }
+            if (WaitForSingleObject(process_, 0) == WAIT_OBJECT_0) { closeHandles(); return false; }
+            Sleep(50);
+        }
+        closeHandles();
+        return false;
+    }
+};
